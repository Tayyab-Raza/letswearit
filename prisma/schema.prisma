generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Shopify session storage — required shape for @shopify/shopify-app-session-storage-prisma
model Session {
  mongoId       String    @id @default(auto()) @map("_id") @db.ObjectId
  id            String    @unique
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Plan {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique // "starter" | "growth" | "pro"
  name              String
  monthlyPrice      Float
  generationLimit   Int      // try-on generations included per billing cycle
  shopifyPlanHandle String   // must match the name used in appSubscriptionCreate
  features          String[] @default([]) // e.g. "tryon" | "size_fit" | "multi_angle_spin" | "full_outfit" | "closet" | "video_tryon"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Store {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  shop                  String    @unique
  ownerEmail            String?
  manualNotifyEmail     String?   // fallback if ownerEmail couldn't be fetched
  installedAt           DateTime  @default(now())
  uninstalledAt         DateTime?

  planKey               String    @default("trial")
  subscriptionId        String?   // Shopify GID of the AppSubscription
  subscriptionStatus    String    @default("trial") // trial | active | cancelled | expired
  trialEndsAt           DateTime?

  currentPeriodStart    DateTime  @default(now())
  currentPeriodEnd      DateTime?
  generationsUsed       Int       @default(0)
  generationLimit       Int       @default(20) // trial default; overwritten on plan change

  warningEmailSentAt    DateTime? // 80%-threshold email, reset each period
  limitEmailSentAt      DateTime? // 100%-reached email, reset each period

  createdAt             DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  usageLogs             UsageLog[]
  generations           Generation[]
  productProfiles       ProductProfile[]
}

model UsageLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId    String   @db.ObjectId
  store      Store    @relation(fields: [storeId], references: [id])
  productId  String
  angle      String
  createdAt  DateTime @default(now())
}

// One classified profile per product, cached so we don't re-classify on every generation.
model ProductProfile {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId       String   @db.ObjectId
  store         Store    @relation(fields: [storeId], references: [id])
  productId     String   // gid://shopify/Product/...
  category      String   // "outfit" | "footwear" | "handbag" | "jewelry_necklace" | "jewelry_ear" | "jewelry_hand"
  subcategory   String?  // "womens" | "mens" | "unisex"
  source        String   @default("heuristic") // "heuristic" | "ai_vision" | "manual"
  analyzedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, productId])
}

// One row per generated result. We store the OUTPUT image only — never the
// customer's uploaded source photo — to keep biometric-data exposure minimal.
model Generation {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  storeId              String   @db.ObjectId
  store                Store    @relation(fields: [storeId], references: [id])
  productId            String
  companionProductIds  String[] @default([]) // other products included in a full-outfit generation
  category             String
  angle                String   // "front" | "side" | "back" | ... | "video"
  mediaType            String   @default("image") // "image" | "video"
  imageUrl             String   // data URL or hosted URL of the OUTPUT only
  shopifyCustomerId    String?  // set when the shopper is logged in
  anonymousId          String   // always set — client-generated id, persisted in localStorage
  planKeyAtGeneration  String
  createdAt            DateTime @default(now())

  @@index([storeId, productId, shopifyCustomerId])
  @@index([storeId, productId, anonymousId])
}